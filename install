#!/bin/bash

# Arch Linux 環境一行安裝腳本
# 使用方式：
#   curl -sL https://raw.githubusercontent.com/alexcsj/archlinux/main/install | bash
#   或
#   sh -c "$(curl -fsSL https://raw.githubusercontent.com/alexcsj/archlinux/main/install)"

set -e

# 顏色定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}ℹ️ $1${NC}"
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

log_warn() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

log_error() {
    echo -e "${RED}❌ $1${NC}"
}

# 標題
echo ""
echo -e "${BLUE}╔══════════════════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║         Arch Linux 環境自動安裝腳本 (alexcsj)                              ║${NC}"
echo -e "${BLUE}╚══════════════════════════════════════════════════════════════════════════════╝${NC}"
echo ""

# 檢查系統
log_info "檢查系統環境..."

if [ ! -f /etc/os-release ]; then
    log_error "無法檢測到 Arch Linux，請確保在 Arch Linux 上運行此腳本"
    exit 1
fi

if ! grep -q "Arch Linux" /etc/os-release; then
    log_warn "系統不是 Arch Linux，但會嘗試繼續..."
fi

log_success "系統檢查通過"
echo ""

# 檢查必要工具
log_info "檢查必要工具..."

if ! command -v git &> /dev/null; then
    log_error "Git 未安裝，請先執行：sudo pacman -S git"
    exit 1
fi

log_success "Git 已安裝"
echo ""

# 克隆倉庫
INSTALL_DIR="${HOME}/.archlinux-setup"
log_info "克隆倉庫到 ${INSTALL_DIR}..."

if [ -d "$INSTALL_DIR" ]; then
    log_warn "目錄已存在，更新倉庫..."
    cd "$INSTALL_DIR"
    git pull origin main
else
    git clone https://github.com/alexcsj/archlinux.git "$INSTALL_DIR"
    cd "$INSTALL_DIR"
fi

log_success "倉庫已克隆"
echo ""

# 進入倉庫目錄
cd "$INSTALL_DIR"

# 解析命令行參數
HARDWARE=""
INTERACTIVE=false
AUTO_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --hardware)
            HARDWARE="$2"
            shift 2
            ;;
        --interactive)
            INTERACTIVE=true
            shift
            ;;
        --auto-only)
            AUTO_ONLY=true
            shift
            ;;
        --help)
            show_help
            ;;
        *)
            log_error "未知選項：$1"
            echo "使用 --help 查看幫助信息"
            exit 1
            ;;
    esac
done

# 自動檢測硬體
detect_hardware() {
    # 檢查是否為聯想 Duet 2022
    if dmidecode -t system 2>/dev/null | grep -iq "duet"; then
        echo "duet-2022"
        return
    fi

    if lsb_release -d 2>/dev/null | grep -iq "lenovo"; then
        echo "duet-2022"
        return
    fi

    # 預設為通用配置
    echo "generic"
}

# 如果未指定硬體
if [ -z "$HARDWARE" ]; then
    if [ "$INTERACTIVE" = true ]; then
        # 互動式模式：顯示菜單
        echo -e "${YELLOW}硬體配置選擇：${NC}"
        echo ""
        echo "  1) 自動檢測"
        echo "  2) 通用 x86_64"
        echo "  3) 聯想小新 Duet 2022"
        echo ""
        read -p "請輸入選擇 (1-3) [預設 1]: " choice
        choice=${choice:-1}

        case $choice in
            1) HARDWARE=$(detect_hardware) ;;
            2) HARDWARE="generic" ;;
            3) HARDWARE="duet-2022" ;;
            *)
                log_error "無效選擇"
                exit 1
                ;;
        esac
    else
        # 一行命令模式：自動檢測，無需用戶交互
        log_info "檢測硬體配置..."
        HARDWARE=$(detect_hardware)
    fi
fi

# 顯示檢測結果
log_success "硬體配置：$HARDWARE"
echo ""

# 執行安裝
log_info "執行安裝腳本..."
echo ""

# 在一行命令模式下自動添加 --yes 標誌
INSTALL_ARGS="--yes"

if [ "$HARDWARE" = "auto-detect" ]; then
    chmod +x scripts/install.sh
    ./scripts/install.sh $INSTALL_ARGS --auto-detect
else
    chmod +x scripts/install.sh
    ./scripts/install.sh $INSTALL_ARGS --hardware "$HARDWARE"
fi

log_success "安裝完成！"
echo ""
echo -e "${GREEN}╔══════════════════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║                          安裝成功！ 🎉                                       ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════════════════════════════════════════╝${NC}"
echo ""
echo "倉庫位置：${INSTALL_DIR}"
echo "訪問文檔：cat ${INSTALL_DIR}/README.md"
echo ""
